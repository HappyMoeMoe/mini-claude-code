# Source install: copy to the repository root's .env and fill in your Key.
# Wheel install: use ~/.config/mini-claude-code/.env instead.
# CLI arguments > process environment > this file > built-in defaults.
# The target workspace's .env is not automatically loaded.
DEEPSEEK_API_KEY=
# Explicit overrides are optional; these are the defaults.
MODEL_ID=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic


# Optional, same-protocol fallback after repeated overload (phase 2).
# FALLBACK_MODEL_ID=
